# ... (gardez les autres imports et la configuration LLM) ...

async def setup_agent():
    use_groq = os.getenv("USE_GROQ", "false").lower() == "true"
    
    if use_groq:
        logger.info("Initializing model via Groq (Cloud)")
        llm = ChatGroq(model="llama-3.1-8b-instant", temperature=0.0)
    else:
        logger.info("Initializing model via Ollama (Local)")
        llm = ChatOllama(model="llama3.1", temperature=0.0)

    # --- NOUVELLE CONNEXION HTTP (SSE) ---
    url_serveur = "http://localhost:8000/sse"
    logger.info(f"Connexion au serveur MCP via {url_serveur}...")
    
    client_ctx = sse_client(url_serveur)
    read_stream, write_stream = await client_ctx.__aenter__()
    
    session_ctx = ClientSession(read_stream, write_stream)
    session = await session_ctx.__aenter__()
    
    await session.initialize()
    
    tools = await load_mcp_tools(session)
    logger.info(f"Outils MCP chargés : {[t.name for t in tools]}")

    memory = MemorySaver()
    
    system_prompt = """You are a League of Legends expert assistant.
    Use the provided tools to search for information in the knowledge base.
    If the tool returns no information, state clearly: "I don't have data on this request."
    Do not guess or hallucinate facts."""

    agent_executor = create_react_agent(
        llm, 
        tools, 
        checkpointer=memory, 
        state_modifier=system_prompt
    )
    
    return agent_executor, session, client_ctx

# ... (le reste du fichier reste identique) ...

# Comme setup_agent est maintenant asynchrone, on l'appelle avec asyncio
def run(app, prompt, thread_id="session_1"):
    config = {"configurable": {"thread_id": thread_id}}
    inputs = {"messages": [("user", prompt)]}
    
    final_response = "An error occurred."
    
    try:
        # app.invoke reste synchrone, LangGraph gère les outils en arrière-plan
        output = app.invoke(inputs, config=config)
        
        if "messages" in output and len(output["messages"]) > 0:
            final_response = output["messages"][-1].content
            
    except Exception as e:
        print(f"Execution error: {e}")

    return final_response, []

# --- Exemple de test rapide si vous lancez ce fichier directement ---
if __name__ == "__main__":
    async def main():
        print("Démarrage de l'agent et connexion au serveur MCP...")
        agent, session, client_ctx = await setup_agent()
        
        print("Posez une question (tapez 'exit' pour quitter) :")
        while True:
            question = input("> ")
            if question.lower() in ["exit", "quit"]:
                break
                
            reponse, _ = run(agent, question)
            print(f"\n🤖 {reponse}\n")
            
        # Fermeture propre de la connexion MCP
        await session_ctx.__aexit__(None, None, None)
        await client_ctx.__aexit__(None, None, None)
        
    asyncio.run(main())